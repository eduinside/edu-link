{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "edu-link",
	"main": "src/server/index.ts",
	"compatibility_date": "2026-05-25",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"placement": {
		"mode": "smart"
	},
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// 단축주소(/abc)·교사 사이트는 Worker가 먼저 받아야 하므로 기본은 전부 Worker.
		// 빌드 파일·글꼴·로고만 정적 자산으로 바로 낸다 → 1년 캐시(_headers) 적용, D1·KV 조회와 무료 요청 한도 절약.
		"run_worker_first": ["/*", "!/assets/*", "!/fonts/*", "!/edulink_logo.png", "!/favicon.ico", "!/robots.txt"]
	},
	"kv_namespaces": [
		{
			"binding": "URL_CACHE",
			"id": "8acabbbf2c7c43eaaf876f0c27cc2bd1"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "edu-link-db",
			"database_id": "e5fa6f54-6063-48f9-9cf3-0517381dd005"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "edulink-pages-media"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}